APP_ENV=development
CREATOR_SERVICE_PORT=8083

DATABASE_URL=postgres://postgres:postgres@localhost:5432/edvance_creator?sslmode=disable

# Must match auth-service: creator-service only VALIDATES tokens, never signs.
# Required. Never commit a real production secret.
JWT_ACCESS_SECRET=
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api

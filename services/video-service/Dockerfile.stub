FROM golang:1.26.5-alpine AS builder
ARG TARGET
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN test -n "$TARGET" && CGO_ENABLED=0 GOOS=linux go build -o /out/stub ./cmd/$TARGET

FROM alpine:3.20
RUN apk add --no-cache ca-certificates wget
WORKDIR /app
COPY --from=builder /out/stub /app/stub
USER 65532:65532
ENTRYPOINT ["/app/stub"]

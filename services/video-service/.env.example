APP_ENV=development
VIDEO_SERVICE_PORT=8085

DATABASE_URL=postgres://postgres:postgres@localhost:5432/edvance_video?sslmode=disable

# Must match auth-service: video-service only VALIDATES tokens, never signs.
# Required. Never commit a real production secret.
JWT_ACCESS_SECRET=
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api

# Shared bearer secret for /internal/v1/* callers (the media engine's
# callback). Required. It is never a user JWT and never appears in logs.
# The gateway does NOT proxy /internal/*; this token stays on private
# networking in production.
INTERNAL_SERVICE_TOKEN=

# --- Object storage (any S3-compatible endpoint: R2, S3, MinIO) --------
# S3_ENDPOINT may be empty for real AWS; MinIO/R2 need it (path-style).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=edvance-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Stable public base URL for playback links when the bucket is public.
# Leave empty to fall back to presigned GET URLs.
S3_PUBLIC_URL=

# --- External media engine (owns FFmpeg; this service never runs it) ---
MEDIA_ENGINE_URL=http://localhost:9090
# Bearer token sent to the engine on job dispatch (optional in dev).
MEDIA_ENGINE_TOKEN=
# Where the engine reports results. Used by cmd/mockengine for e2e.
VIDEO_SERVICE_CALLBACK_URL=http://localhost:8085/internal/v1/videos/processing/callback

# --- Upload limits -------------------------------------------------------
UPLOAD_URL_TTL_SECONDS=900
MAX_VIDEO_SIZE_BYTES=2147483648
MAX_VIDEO_DURATION_SECONDS=14400

# --- Background processing worker ---------------------------------------
PROCESSING_WORKER_COUNT=4
PROCESSING_MAX_ATTEMPTS=4
PROCESSING_RETRY_BASE_SECONDS=15
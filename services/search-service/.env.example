APP_ENV=development
SEARCH_SERVICE_PORT=8091

# Search service owns its own database (edvance_search). It never
# connects to another service's database.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edvance_search?sslmode=disable

# Optional. Public search is unauthenticated. Set only to enable
# optional caller-identity attachment. Must match auth-service.
JWT_ACCESS_SECRET=
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api

# Guards /internal/v1/* (indexing upsert/delete/reindex). Routes
# fail closed — always 401 — while this is empty. Never exposed
# through the API gateway.
INTERNAL_SERVICE_TOKEN=

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=50
SEARCH_MAX_QUERY_LENGTH=200
SEARCH_MAX_SUGGEST_LENGTH=50
SEARCH_MAX_REINDEX_BATCH=500

APP_ENV=development
USER_SERVICE_PORT=8082

DATABASE_URL=postgres://postgres:postgres@localhost:5432/edvance_user?sslmode=disable

# Must match auth-service: user-service only VALIDATES tokens, never signs.
# Required. Never commit a real production secret.
JWT_ACCESS_SECRET=
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api

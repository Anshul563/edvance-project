# live-streaming-service local development environment.
# Copy to services/live-streaming-service/.env for `go run ./cmd/server`.

APP_ENV=development
LIVE_STREAMING_SERVICE_PORT=8096

# Dedicated database; run migrations/001_create_stream_sessions.sql first.
DATABASE_URL=postgres://postgres:postgres@localhost:15432/edvance_live?sslmode=disable

# Must match auth-service. This service only validates tokens.
JWT_ACCESS_SECRET=
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api

# Shared secret used by MediaMTX to authenticate authorize/publish/done
# callbacks. Never commit a real value.
INTERNAL_SERVICE_TOKEN=

# MediaMTX control API (private network only; never expose publicly).
MEDIAMTX_API_URL=http://localhost:9997

# Externally visible addresses handed to OBS and students. Use your LAN
# IP instead of localhost when clients run on other devices.
RTMP_PUBLIC_URL=rtmp://localhost:1935
HLS_PUBLIC_BASE_URL=http://localhost:8888
STREAM_PATH_PREFIX=ls

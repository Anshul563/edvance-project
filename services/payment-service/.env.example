APP_ENV=development
PAYMENT_SERVICE_PORT=8090

DATABASE_URL=postgres://postgres:postgres@localhost:5432/edvance_payment?sslmode=disable

# Must match auth-service: payment-service only VALIDATES tokens, never signs.
# Required. Never commit a real production secret.
JWT_ACCESS_SECRET=
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api

# Razorpay credentials. NEVER commit real values.
# Use rzp_test_... keys for development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com

# Commerce-service for order reads and payment outcomes (never its database).
COMMERCE_SERVICE_URL=http://localhost:8089
COMMERCE_SERVICE_INTERNAL_TOKEN=

APP_ENV=development
MEDIA_SERVICE_PORT=8091

DATABASE_URL=postgres://postgres:postgres@localhost:5432/edvance_media?sslmode=disable

# Must match auth-service: media-service only VALIDATES tokens, never signs.
# Required. Never commit a real production secret.
JWT_ACCESS_SECRET=
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api

# Media engine (external Go + FFmpeg service) connection.
# The internal token is known ONLY to media-service, never to clients.
MEDIA_ENGINE_URL=http://localhost:9000
MEDIA_ENGINE_INTERNAL_TOKEN=

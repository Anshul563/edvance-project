APP_ENV=development
COMMERCE_SERVICE_PORT=8089

DATABASE_URL=postgres://postgres:postgres@localhost:5432/edvance_commerce?sslmode=disable

# Must match auth-service: commerce-service only VALIDATES tokens, never signs.
# Required. Never commit a real production secret.
JWT_ACCESS_SECRET=
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api

# Course-service for live pricing (read-only, never its database).
COURSE_SERVICE_URL=http://localhost:8086

# Learning-service for enrollment provisioning (replaceable seam).
LEARNING_SERVICE_URL=http://localhost:8087

# Shared secret for payment-service internal callbacks. Never commit real values.
COMMERCE_SERVICE_INTERNAL_TOKEN=

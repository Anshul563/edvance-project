APP_ENV=development
CONTENT_SERVICE_PORT=8084

DATABASE_URL=postgres://postgres:postgres@localhost:5432/edvance_content?sslmode=disable

# Must match auth-service: content-service only VALIDATES tokens, never signs.
# Required. Never commit a real production secret.
JWT_ACCESS_SECRET=
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api

# Ownership: the caller's own token is forwarded here to learn which
# creator they own. Never point this at a database.
CREATOR_SERVICE_URL=http://localhost:8083

# Publish events, best effort: a notification outage never fails a
# publish. NOTIFICATION_INTERNAL_TOKEN is the shared service token.
NOTIFICATION_SERVICE_URL=http://localhost:8092
NOTIFICATION_INTERNAL_TOKEN=

# Guards /internal/* (media-status callbacks, counters). Routes fail
# closed — always 401 — while this is empty. Never exposed to clients.
INTERNAL_API_KEY=

MAX_SHORT_DURATION_SECONDS=180
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
MAX_TAGS_PER_ITEM=10

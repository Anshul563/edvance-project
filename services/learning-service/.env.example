APP_ENV=development
LEARNING_SERVICE_PORT=8087

DATABASE_URL=postgres://postgres:postgres@localhost:5432/edvance_learning?sslmode=disable

# Must match auth-service: learning-service only VALIDATES tokens, never signs.
# Required. Never commit a real production secret.
JWT_ACCESS_SECRET=
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api

# Course-service for course/lesson validation (read-only, never its database).
COURSE_SERVICE_URL=http://localhost:8086

# Progress percent at which a lesson counts as completed.
LESSON_COMPLETION_PERCENT=90

# Shared secret for commerce-service internal enrollment. Never commit real values.
LEARNING_SERVICE_INTERNAL_TOKEN=

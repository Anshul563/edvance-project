APP_ENV=development
AUTH_SERVICE_PORT=8081

DATABASE_URL=postgres://postgres:postgres@localhost:5432/edvance_auth?sslmode=disable

REDIS_URL=redis://localhost:6379/0

# Required. Never commit a real production secret.
# Generate your own, e.g.:
#   openssl rand -base64 64
JWT_ACCESS_SECRET=
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Email delivery. Providers: console (development only), smtp.
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@edvance.local
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_TTL=24h
EMAIL_RESEND_COOLDOWN=1m

# Required only when EMAIL_PROVIDER=smtp. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

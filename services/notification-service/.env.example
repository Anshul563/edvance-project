APP_ENV=development
NOTIFICATION_SERVICE_PORT=8092

DATABASE_URL=postgres://postgres:postgres@localhost:5432/edvance_notification?sslmode=disable

# Must match auth-service: notification-service only VALIDATES tokens, never signs.
# Required. Never commit a real production secret.
JWT_ACCESS_SECRET=
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api

# Outbound email. Providers: console (development only), smtp.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Shared secret for trusted services calling the internal event API.
# Required. Never commit a real production secret.
NOTIFICATION_INTERNAL_TOKEN=

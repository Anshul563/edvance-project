APP_ENV=development
ANALYTICS_SERVICE_PORT=8097
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edvance_analytics?sslmode=disable
JWT_ACCESS_SECRET=replace_with_shared_auth_secret
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api
INTERNAL_SERVICE_TOKEN=replace_with_shared_internal_token
MAX_REQUEST_SIZE_BYTES=1048576
MAX_BATCH_SIZE=100
MAX_DATE_RANGE_DAYS=90
API_GATEWAY_URL=http://localhost:8080

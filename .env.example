APP_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222

JWT_ACCESS_SECRET=replace-me-local-dev-only
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api
ADMIN_ALLOWED_USER_IDS=00000000-0000-0000-0000-000000000001
INTERNAL_SERVICE_TOKEN=replace-me-local-dev-only

DATABASE_URL=postgres://postgres:postgres@postgres:5432/edvance_admin?sslmode=disable
AUTH_DATABASE_URL=postgres://postgres:postgres@postgres:5432/edvance_auth?sslmode=disable
ANALYTICS_DATABASE_URL=postgres://postgres:postgres@postgres:5432/edvance_analytics?sslmode=disable
RECOMMENDATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/edvance_recommendation
MODERATION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/edvance_moderation
REDIS_URL=redis://redis:6379/0

API_GATEWAY_URL=http://api-gateway:8080
AUTH_SERVICE_URL=http://auth-service:8081
ANALYTICS_SERVICE_URL=http://analytics-service:8097
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8093
MODERATION_SERVICE_URL=http://moderation-service:8094

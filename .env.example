APP_ENV=development

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

JWT_ACCESS_SECRET=replace-me-local-dev-only
JWT_ISSUER=edvance-auth
JWT_AUDIENCE=edvance-api
ADMIN_ALLOWED_USER_IDS=00000000-0000-0000-0000-000000000001
INTERNAL_SERVICE_TOKEN=replace-me-local-dev-only
INTERNAL_API_KEY=replace-me-local-dev-only

# --- Standalone video (content-service + video-service) ---------------
VIDEO_SERVICE_URL=http://localhost:8085
CONTENT_SERVICE_URL=http://localhost:8084

REDIS_URL=redis://redis:6379/0

LEARNING_SERVICE_INTERNAL_TOKEN=replace-me-local-dev-only
COMMERCE_SERVICE_INTERNAL_TOKEN=replace-me-local-dev-only

# --- Live streaming (live-streaming-service + MediaMTX) -----------------
# PUBLIC addresses handed to OBS and to student devices. Replace
# localhost with your computer's LAN IP (e.g. 192.168.1.20) when testing
# from a physical phone or from OBS on another machine.
RTMP_PUBLIC_URL=rtmp://localhost:1935
HLS_PUBLIC_BASE_URL=http://localhost:8888
# Host ports for RTMP ingest and HLS playback.
RTMP_PORT=1935
HLS_PORT=8888
# Optional override; defaults to postgres:5432/edvance_live inside compose.
# LIVE_DATABASE_URL=postgres://postgres:postgres@postgres:5432/edvance_live?sslmode=disable

# Payment Service is optional and requires Razorpay test credentials.
RAZORPAY_BASE_URL=https://api.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=edvance-media
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=
